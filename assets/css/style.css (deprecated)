body {
  margin: 0;
  font-family: Inter, system-ui, Segoe UI, Roboto, Arial;
  background-color: var(--background-color);
  color: var(--text-primary);
  transition: all 0.3s ease;
}

/* Make body fill full screen */
html, body {
  height: auto;
  margin: 0;
  display: flex;
  flex-direction: column;
  overflow-y: auto;
}

/* Mobile overflow override - placed after main rules for proper precedence */
@media (max-width: 768px) {
  html, body {
    overflow-y: auto;
    height: auto;
  }
}

/* Container stretches to push footer down */
.page-container {
  flex: 1;
  display: flex;
  flex-direction: column;
}

/* Content grows, footer stays at bottom */
.content {
  flex: 1;
  margin-top: 1rem; /* Add space between header and main content */
}

/* Main panel styling */
main.panel {
  margin-top: 1rem; /* Ensure proper spacing from site header */
}



/* LAYOUT */
.container {
  max-width: 1100px;
  margin: 0 auto;
  display: grid;
  grid-template-columns: 300px 1fr;
  gap: 18px;
  background-color: transparent;
}

@media (max-width: 980px) {
  .container {
    grid-template-columns: 1fr;
    gap: 16px;
  }
  .chart-wrap {
    width: 100%;
    height: 200px;
  }
}

@media (max-width: 768px) {
  .container {
    grid-template-columns: 1fr !important;
    gap: 16px !important;
    padding: 0 16px !important;
    max-width: 100% !important;
    display: grid !important;
  }
  
  .conversion-grid {
    grid-template-columns: 1fr !important;
    gap: 16px !important;
    display: grid !important;
  }
  
  .conversion-col {
    width: 100% !important;
    min-width: 0 !important;
    grid-column: 1 !important;
  }
  
  /* Force mobile layout */
  main.panel {
    width: 100% !important;
    max-width: 100% !important;
  }
  
  main.panel .container {
    width: 100% !important;
    max-width: 100% !important;
  }
  
  /* Override inline grid styles */
  [style*="grid-template-columns"] {
    grid-template-columns: 1fr !important;
  }
  
  /* Override specific inline grid layouts */
  [style*="grid-template-columns: 1fr 1fr"] {
    grid-template-columns: 1fr !important;
  }
  
  [style*="grid-template-columns: 50% 50%"] {
    grid-template-columns: 1fr !important;
  }
  
  [style*="grid-template-columns: 60% 40%"] {
    grid-template-columns: 1fr !important;
  }
  
  [style*="grid-template-columns: 35% 13% 52%"] {
    grid-template-columns: 1fr !important;
  }
  
  [style*="grid-template-columns: 40% 13% 47%"] {
    grid-template-columns: 1fr !important;
  }
  
  [style*="grid-template-columns: 20% 20%"] {
    grid-template-columns: 1fr !important;
  }
}

/* Responsive Grid System */
.conversion-grid {
  display: grid;
  grid-template-columns: repeat(auto-fit, minmax(300px, 1fr));
  gap: 24px;
  margin-bottom: 24px;
}

.conversion-col {
  min-width: 0; /* Prevents grid items from overflowing */
}

/* Responsive breakpoints */
@media (max-width: 1200px) {
  .conversion-grid {
    grid-template-columns: repeat(auto-fit, minmax(280px, 1fr));
    gap: 20px;
  }
}

@media (max-width: 768px) {
  .conversion-grid {
    grid-template-columns: 1fr;
    gap: 16px;
  }
  
  .conversion-col {
    width: 100%;
  }
}


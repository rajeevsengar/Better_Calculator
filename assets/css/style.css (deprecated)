/* Enhanced Toggle Styles */
.enhanced-toggle {
  margin-bottom: 16px;
  padding: 16px;
  background: var(--card-bg);
  border-radius: 8px;
  border: 1px solid var(--border-color);
}

/* Quick Link Styles */
.quick-links {
  font-size: 12px;
}

.quick-link {
  color: var(--primary-color);
  text-decoration: none;
  cursor: pointer;
  transition: color 0.2s ease;
}

.quick-link:hover {
  color: var(--accent-color);
  text-decoration: underline;
}

.toggle-container {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 16px;
}

.toggle-label {
  font-size: 14px;
  font-weight: 500;
  color: var(--text-color);
  cursor: pointer;
  flex: 1;
}

.toggle-switch {
  position: relative;
  flex-shrink: 0;
}

.toggle-switch input[type="checkbox"] {
  display: none;
}

.toggle-slider {
  position: relative;
  width: 48px;
  height: 26px;
  background: var(--border-color);
  border-radius: 13px;
  transition: background 0.3s ease;
  cursor: pointer;
  display: block;
}

.toggle-slider:before {
  content: '';
  position: absolute;
  top: 2px;
  left: 2px;
  width: 22px;
  height: 22px;
  background: white;
  border-radius: 50%;
  transition: transform 0.3s ease;
}

.toggle-switch input[type="checkbox"]:checked + .toggle-slider {
  background: var(--primary-color);
}

.toggle-switch input[type="checkbox"]:checked + .toggle-slider:before {
  transform: translateX(22px);
}

/* Mobile-specific enhanced toggle adjustments */
@media (max-width: 768px) {
  .enhanced-toggle {
    padding: 20px;
    margin-bottom: 20px;
  }
  
  .toggle-label {
    gap: 24px;
    font-size: 13px;
    line-height: 1.4;
  }
  
  .toggle-slider {
    width: 52px;
    height: 28px;
  }
  
  .toggle-slider:before {
    width: 24px;
    height: 24px;
  }
  
  .toggle-switch input[type="checkbox"]:checked + .toggle-slider:before {
    transform: translateX(24px);
  }
}

